	</column>
	<column name="updated_at" not-null="true" default-value="now()">
		<type name="timestamptz" length="0"/>
	</column>
	<column name="deleted_at">
		<type name="timestamptz" length="0"/>
	</column>
	<constraint name="user_chat_pk" type="pk-constr" table="public.user_chat">
		<columns names="id_user,id_chat" ref-type="src-columns"/>
	</constraint>
	<constraint name="chk_user_chat_role" type="ck-constr" table="public.user_chat">
			<expression> <![CDATA[role IN ('OWNER', 'ADMIN', 'MEMBER')]]> </expression>
	</constraint>
</table>

